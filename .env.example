# ─────────────────────────────────────────────────────────────
#  Portfolio Bachir Sy — variables d'environnement
#  1. Copiez ce fichier en « .env » (déjà fait dans le zip)
#  2. Remplissez les valeurs, puis redémarrez « npm start »
#  Toutes les variables doivent commencer par REACT_APP_
# ─────────────────────────────────────────────────────────────

# EmailJS — https://dashboard.emailjs.com
# Email Services → Service ID
REACT_APP_EMAILJS_SERVICE_ID=service_zvbcs6f
# Email Templates → Template ID (ex. template_ab12cd3)
REACT_APP_EMAILJS_TEMPLATE_ID=
# Account → General → Public Key
REACT_APP_EMAILJS_PUBLIC_KEY=

# Adresse affichée sur le site et utilisée en secours (mailto)
REACT_APP_CONTACT_EMAIL=bachirsy26@gmail.com

# Liens optionnels : les boutons n'apparaissent que si la valeur est remplie
REACT_APP_LINKEDIN_URL=https://linkedin.com/in/bachirsy
REACT_APP_GITHUB_URL=
# Les CV sont servis depuis public/cv/ (frcvlight, frcvdark, encvlight, encvdark).
